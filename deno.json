{
  "name": "@inialum/token-generator",
  "license": "Apache-2.0",
  "exports": "./src/main.ts",
  "publish": {
    "include": [
      "LICENSE",
      "README.md",
      "src/**/*.ts"
    ],
    "exclude": [
      "src/**/*_test.ts",
      "src/testdata/**/*"
    ]
  },
  "tasks": {
    "dev": "deno run --watch ./src/main.ts",
    "test:ci": "deno test -A --failfast"
  },
  "imports": {
    "@deno/dnt": "jsr:@deno/dnt@^0.43.2",
    "@dotenvx/dotenvx": "npm:@dotenvx/dotenvx@^2.21.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/cli": "jsr:@std/cli@^1.0.32",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/path": "jsr:@std/path@^1.1.6",
    "jose": "npm:jose@^6.2.8"
  },
  "exclude": ["npm"],
  "fmt": {
    "exclude": ["*.md"]
  }
}
